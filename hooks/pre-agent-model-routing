#!/usr/bin/env bash
# PreToolUse hook on Agent: enforce per-task model-tier routing via project config.
#
# Ships plugin-level (registered via hooks/hooks.json) but stays dormant unless
# the project opts in by creating docs/superpowers/model-routing.json. With the
# file present, each Agent dispatch's model parameter must agree with the
# in_progress task's resolved tier — or with the reviewer tier ("standard"),
# because spec & code-quality reviewer subagents are dispatched while the same
# task is still in_progress.
#
# model-routing.json maps tier names to model strings, e.g.:
#   {"mechanical":"haiku","standard":"sonnet","frontier":"inherit"}
#
# The value "inherit" means any model (or none) is acceptable.
# A concrete model value in task metadata ("model" key) overrides the tier;
# in that case this hook defers to hooks/examples/pre-agent-task-dispatch-validate.sh.
#
# Decision order:
#   1. SUPERPOWERS_ROUTING_GUARD=0 → allow.
#   2. tool_name != "Agent" → allow.
#   3. subagent_type set and != "general-purpose" → allow when a model param
#      was passed explicitly (custom types keep their own cost profiles).
#      With NO model param, resolve the agent definition's frontmatter
#      `model:` from .claude/agents/<type>.md (project then user) and run the
#      tier check against it; unresolvable or `inherit` → allow (fail-open).
#   4. Routing file absent or unparseable → allow (dormant / fail-open).
#      Lookup: <cwd>/docs/superpowers/model-routing.json first, else
#      $HOME/.claude/superpowers/model-routing.json (user-level default).
#      First file found wins entirely; no merging.
#   5. No in_progress task, or task has neither "model" nor "modelTier" → allow.
#   6. Task has a concrete "model" pin → allow (dispatch-validate hook owns pins).
#   7. Task tier not in routing file → allow (fail-open, typos must not brick dispatches).
#   8. Task tier maps to "inherit" → allow (no constraint for this task).
#   9. Otherwise allowed = { resolve(task tier), resolve("standard") } (deduped;
#      members whose tier is missing from the routing file are dropped).
#      "standard" mapping to "inherit" makes the reviewer member a wildcard →
#      allow any. Dispatch model in the allowed set → allow. Missing model
#      param or model outside the set → block.
#
# Escape hatch: SUPERPOWERS_ROUTING_GUARD=0 to disable.

TRACE_LOG="${SUPERPOWERS_USERGATE_TRACE_LOG:-/tmp/claude-hooks/user-gate-trace.log}"
mkdir -p "$(dirname "$TRACE_LOG")" 2>/dev/null || true
trace() {
    local tid="${1:-?}" event="${2:-?}" reason="${3:-}"
    printf '%s | pre-routing | task=%s | %s%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tid" "$event" \
        "${reason:+ | $reason}" >> "$TRACE_LOG" 2>/dev/null || true
}

ALLOW='{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}}'

if [[ "${SUPERPOWERS_ROUTING_GUARD:-1}" == "0" ]]; then
    trace "?" "skip" "guard=0"
    echo "$ALLOW"; exit 0
fi

trap 'trace "?" "error" "trap-ERR"; echo "$ALLOW"; exit 0' ERR

INPUT=$(cat)

# One jq pass for every scalar input field (was five separate jq spawns).
# One field per line, embedded CR/LF flattened to spaces. NOTE: \x01
# separators are not an option here — bash 3.2 uses \x01 internally
# (CTLESC) and IFS=$'\x01' silently fails to split on stock macOS bash.
# jq parse failure fails the assignment → ERR trap → allow.
# Trailing `tr -d '\r'` strips the CRLF that native Windows jq/python3
# emit (no-op elsewhere); `exit "${PIPESTATUS[N]}"` re-exports the
# producer's exit status so the fail-open fallbacks keep firing.
FIELDS=$(echo "$INPUT" | jq -r '[(.tool_name // ""), (.tool_input.model // ""), (.tool_input.subagent_type // ""), (.cwd // ""), (.transcript_path // "")] | map(tostring | gsub("\\r|\\n"; " ")) | .[]' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")
{ IFS= read -r TOOL_NAME; IFS= read -r AGENT_MODEL; IFS= read -r AGENT_TYPE; IFS= read -r CWD; IFS= read -r TRANSCRIPT_PATH; } <<< "$FIELDS" || true

[[ "$TOOL_NAME" != "Agent" ]] && { trace "?" "skip" "tool=$TOOL_NAME"; echo "$ALLOW"; exit 0; }

# Custom agent types (subagent_type set and != "general-purpose") with an
# explicit model param stay fully exempt - they have their own cost profiles
# (llama/Explore/code-reviewer/etc.); only implementer/reviewer-grade
# dispatches are routed. The exemption hid one real drift path though: a
# custom type with NO model param. The Agent tool contract is "param omitted →
# the agent definition's model, else inherit the parent", so resolve the
# frontmatter `model:` pin from .claude/agents/<type>.md (project first, then
# user-level) and run the tier check against it. Unresolvable (no def file,
# no model key, or `model: inherit`) → exempt, fail-open as before.
# Resolve a single key out of an agent definition's FIRST YAML fence.
# Value normalization: strip a trailing YAML comment, then CR/space/quotes
# (model: "sonnet" == model: sonnet # note == model: sonnet) - a decorated
# but valid pin must not read as unknown and wrongly block. The scan is
# bounded to the first fence pair via awk, so a stray '---' pair with a
# model: line in the BODY cannot mint a phantom pin. CRLF-fenced defs match
# no fence and resolve empty.
#
# Lookup order: project, then user level. These are the only two locations that
# can hold an agent definition here - this plugin deliberately ships NO named
# agents (precedent: commit 8d9d82b removed the last one and the agents/ dir
# with it). The effort-pinned definitions that make enforceEffort usable are
# written into one of these two paths by /onboard when the user opts in, which
# keeps them behind the opt-in instead of costing every install unconditionally.
# A third <plugin_root>/agents/ path was tried and removed: with nothing shipped
# there it could never resolve, so it was dead code by construction.
resolve_agent_key() {
    local type="$1" key="$2" def val=""
    for def in "${CWD:-$PWD}/.claude/agents/$type.md" \
               "$HOME/.claude/agents/$type.md"; do
        [[ -f "$def" ]] || continue
        val=$(awk '/^---$/{n++; next} n==1' "$def" 2>/dev/null \
              | sed -n "s/^$key:[[:space:]]*//p" | head -1 \
              | sed 's/[[:space:]]*#.*$//' | tr -d "\r \"'")
        [[ -n "$val" ]] && break
    done
    printf '%s' "$val"
}

# Routing config is read BEFORE the agent-type block on purpose: whether the
# exemption below is narrowed depends on enforceEffort, so that flag has to be
# known first. Reading it here also preserves the pre-6.4 fast path - a dispatch
# that is exempt and has no effort enforcement to run exits immediately, without
# touching the transcript (see the early exit after the block).

# Locate routing file: project first, then user-level default. First found wins.
[[ -z "$CWD" ]] && CWD="$PWD"
ROUTING_FILE="$CWD/docs/superpowers/model-routing.json"
ROUTING_LABEL="docs/superpowers/model-routing.json"
if [[ ! -f "$ROUTING_FILE" ]]; then
    ROUTING_FILE="$HOME/.claude/superpowers/model-routing.json"
    ROUTING_LABEL="~/.claude/superpowers/model-routing.json"
fi

if [[ ! -f "$ROUTING_FILE" ]]; then
    trace "?" "skip" "no-routing-file"
    echo "$ALLOW"; exit 0
fi

# Parse routing file; fail-open if unparseable.
ROUTING_JSON=$(jq '.' "$ROUTING_FILE" 2>/dev/null) || {
    trace "?" "skip" "routing-file-unparseable"
    echo "$ALLOW"; exit 0
}

# Effort enforcement is a separate, explicitly opted-in dial. Absent or false
# -> the effort map stays advisory exactly as before (the session-start notice
# carries it and nothing checks it), so no existing install changes behavior.
# True -> a dispatch serving a tiered task must resolve to that tier's effort.
ENFORCE_EFFORT=$(echo "$ROUTING_JSON" | jq -r '.enforceEffort // false' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")

# Custom agent types (subagent_type set and != "general-purpose") with an
# explicit model param keep their MODEL exemption - they have their own cost
# profiles (llama/Explore/code-reviewer/etc.). With NO model param, the Agent
# tool contract is "param omitted -> the agent definition's model, else
# inherit the parent", so the frontmatter model: pin is resolved and the tier
# check runs against it. Unresolvable or `inherit` -> model check exempt,
# fail-open as before.
MODEL_EXEMPT=""
AGENT_EFFORT=""
if [[ -n "$AGENT_TYPE" && "$AGENT_TYPE" != "general-purpose" ]]; then
    AGENT_EFFORT=$(resolve_agent_key "$AGENT_TYPE" "effort")
    DEF_MODEL=$(resolve_agent_key "$AGENT_TYPE" "model")
    if [[ -n "$DEF_MODEL" && "$DEF_MODEL" != "inherit" ]]; then
        # The definition carries its own model - a real cost profile.
        if [[ -n "$AGENT_MODEL" ]]; then
            MODEL_EXEMPT=1
            trace "?" "skip" "custom-agent-type-model-exempt type=$AGENT_TYPE effort=${AGENT_EFFORT:-none}"
        else
            AGENT_MODEL="$DEF_MODEL"
            trace "?" "resolved" "custom-agent-type type=$AGENT_TYPE model=$AGENT_MODEL effort=${AGENT_EFFORT:-none}"
        fi
    elif [[ "$ENFORCE_EFFORT" == "true" && -n "$AGENT_MODEL" && -n "$AGENT_EFFORT" ]]; then
        # Definition pins an effort but no model: it has opted INTO the routing
        # system and deliberately left the model to the call. So the param is
        # the only model signal and must obey the tier - otherwise the very
        # types we recommend for effort compliance would be a hole through
        # which any model passes.
        #
        # Gated on enforceEffort, and that gate is load-bearing. Without it this
        # branch silently narrows a pre-existing exemption for EVERY model-routing
        # user, including anyone whose own agent definition happens to carry a
        # bare `effort:` key for unrelated reasons - a breaking change riding
        # inside a feature they never enabled. Measured before gating: a dispatch
        # that returned ALLOW under v6.3.0 returned BLOCK, with enforceEffort
        # absent. Opting in is what buys the stricter rule.
        #
        # A definition pinning NEITHER model nor effort (Explore, fork, and
        # other read-only or externally-priced helpers) keeps its MODEL
        # exemption - it never asked to be routed.
        #
        # Scope, precisely: that exemption is the model dial only. The effort
        # check below has no matching carve-out, so under enforceEffort such a
        # type IS blocked while a routed task is in_progress - it pins no
        # effort, which is exactly the hole enforcement exists to close. That
        # is announced, not incidental: the enforced session-start notice tells
        # the session to route through an effort-pinned type. It does bite
        # built-ins like Explore, which cannot be pinned without shadowing
        # them; whether they deserve a carve-out is an open decision, not
        # something to infer from this comment.
        trace "?" "resolved" "routed-type-param-model type=$AGENT_TYPE model=$AGENT_MODEL effort=$AGENT_EFFORT"
    elif [[ -n "$AGENT_MODEL" ]]; then
        # Effort enforcement off: keep the historical unconditional exemption.
        MODEL_EXEMPT=1
        trace "?" "skip" "custom-agent-type-model-exempt type=$AGENT_TYPE effort=${AGENT_EFFORT:-none}"
    else
        # No model anywhere - nothing to check. Fail-open, unchanged.
        MODEL_EXEMPT=1
        trace "?" "skip" "custom-agent-type-unresolved type=$AGENT_TYPE effort=${AGENT_EFFORT:-none}"
    fi
fi

# FAST PATH - restores the pre-6.4 exit point. An exempt dispatch with no effort
# enforcement to run has nothing left to decide, so it returns here instead of
# falling through the transcript scan below. Without this, adding effort support
# put a ~50-90ms tax (roughly 2x wall time, measured) on every Agent dispatch for
# every model-routing user, including those who never opted into enforcement.
if [[ -n "$MODEL_EXEMPT" && "$ENFORCE_EFFORT" != "true" ]]; then
    echo "$ALLOW"; exit 0
fi

[[ -z "$TRANSCRIPT_PATH" || ! -f "$TRANSCRIPT_PATH" ]] && {
    trace "?" "skip" "no-transcript"
    echo "$ALLOW"; exit 0
}

# Walk the transcript: collect ALL in_progress tasks + their model/modelTier.
# Bounded parallel dispatch means several tasks can be in_progress at once
# (subagent-driven-development permits disjoint-files parallel streams); a
# dispatch for ANY of them is legitimate, so the gate validates against the
# union of their tiers, not just the most recent task.
#
# A task's native id is in its TaskCreate result ("Task #N created successfully"),
# not the tool_use input; TaskUpdate uses that real id. We key tasks by it — the
# old 1..N create-count mis-keyed once earlier tasks shifted the numbering (a
# frontier task read as standard, blocking a valid dispatch). Result-less
# transcripts (synthetic fixtures) keep the legacy 1..N order.
#
# The file is streamed in BINARY with a substring pre-filter: only lines with
# "TaskCreate"/"TaskUpdate"/"created successfully" are parsed, so everything else
# skips json.loads. This keeps the scan linear-in-bytes, avoids loading hundreds
# of MB into memory, and — unlike text-mode readlines() — means one invalid-UTF-8
# byte poisons only its own line instead of disabling the gate for the session.
# Output: four lines — task_id, has_pin, subject, comma-joined tiers.
PY_SCAN='
import json, re, sys
path = sys.argv[1]

creates = []       # (tool_use_id, meta) in creation order
real_id = {}       # tool_use_id -> native id (str), from the create result
inprogress = []    # native ids, most recent LAST
upd_desc = {}      # native id -> description carried on a TaskUpdate
CREATE_RE = re.compile(r"Task #(\d+) created successfully")

def clean(s):
    return str(s).replace("\n", " ").replace("\r", " ")

try:
    f = open(path, "rb")
except Exception:
    print("?\nfalse\n\n"); sys.exit(0)

with f:
    for line in f:
        if (b"TaskCreate" not in line and b"TaskUpdate" not in line
                and b"created successfully" not in line):
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        for c in (e.get("message") or {}).get("content") or []:
            if not isinstance(c, dict):
                continue
            t = c.get("type")
            inp = c.get("input") or {}
            if t == "tool_use" and c.get("name") == "TaskCreate":
                creates.append((c.get("id"), {
                    "subject": inp.get("subject", "") or "",
                    "description": inp.get("description", "") or "",
                }))
            elif t == "tool_use" and c.get("name") == "TaskUpdate":
                tid = str(inp.get("taskId", ""))
                if not tid:
                    continue
                if inp.get("description"):
                    upd_desc[tid] = inp["description"]
                status = inp.get("status")
                if status == "in_progress":
                    if tid in inprogress:
                        inprogress.remove(tid)
                    inprogress.append(tid)
                elif status in ("completed", "cancelled", "deleted"):
                    if tid in inprogress:
                        inprogress.remove(tid)
            elif t == "tool_result":
                content = c.get("content")
                if isinstance(content, list):
                    content = " ".join(b.get("text", "") for b in content if isinstance(b, dict))
                m = CREATE_RE.search(content if isinstance(content, str) else "")
                if m:
                    real_id[c.get("tool_use_id")] = m.group(1)

# Key tasks by native id when results are present, else by 1..N creation order.
if real_id:
    tasks = {real_id[t]: meta for t, meta in creates if t in real_id}
else:
    tasks = {str(i): meta for i, (t, meta) in enumerate(creates, 1)}
for tid, desc in upd_desc.items():
    tasks.setdefault(tid, {"subject": "", "description": ""})["description"] = desc

def fence_meta(desc):
    m = re.search(r"```json:metadata\s*\n(.*?)\n```", desc, re.DOTALL)
    if not m:
        return {}
    try:
        return json.loads(m.group(1))
    except Exception:
        return {}

most_recent = inprogress[-1] if inprogress else None
subject = tasks.get(most_recent, {}).get("subject", "") if most_recent else ""

has_pin = False
seen = []
for tid in inprogress:
    meta = fence_meta(tasks.get(tid, {}).get("description", ""))
    if meta.get("model"):
        has_pin = True
    tier = meta.get("modelTier")
    if tier and tier not in seen:
        seen.append(tier)

print("\n".join([
    clean(most_recent) if most_recent is not None else "?",
    "true" if has_pin else "false",
    clean(subject),
    ",".join(clean(t) for t in seen),
]))
'

RESULT=$(python3 -c "$PY_SCAN" "$TRANSCRIPT_PATH" 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[0]}") || RESULT=$'?\nfalse\n\n'
{ IFS= read -r TASK_ID; IFS= read -r HAS_PIN; IFS= read -r SUBJECT; IFS= read -r TIERS_CSV; } <<< "$RESULT" || true
TASK_ID="${TASK_ID:-?}"
TIERS_DISPLAY="$TIERS_CSV"

# No in_progress task, or none of them carries a tier or pin → allow.
if [[ "$HAS_PIN" != "true" && -z "$TIERS_CSV" ]]; then
    trace "$TASK_ID" "pass" "no-tier-requirement"
    echo "$ALLOW"; exit 0
fi

# ---------------------------------------------------------------------------
# Effort enforcement (opt-in via "enforceEffort": true).
#
# Runs BEFORE the model logic and before the pin defer, because effort is an
# independent dial: a task that pins its own model still has a tier effort to
# obey, and the model branches below all exit early on their own terms.
#
# The Agent tool has no effort parameter, so the effort a dispatch will run at
# is whatever its agent definition pins. That makes the enforceable rule
# "route through something that pins the required effort" - which is exactly
# what the session notice already asks for in prose.
#
# Allowed set mirrors the model side: the union of the in-progress tiers'
# efforts PLUS the "standard" reviewer effort, since spec and code-quality
# reviewers run at standard while their task is in progress. Any member
# resolving to "inherit" removes the constraint entirely.
effort_for_tier() {
    local tier="$1" v
    v=$(echo "$ROUTING_JSON" | jq -r --arg t "$tier" '.effort[$t] // empty' 2>/dev/null | tr -d '\r')
    if [[ -z "$v" ]]; then
        # Implicit default - the same map the session-start notice carries when
        # the routing file has no "effort" key. Without this, enforceEffort on
        # a file with no effort map would silently enforce nothing.
        case "$tier" in
            mechanical) v="low" ;;
            standard)   v="medium" ;;
            frontier)   v="inherit" ;;
        esac
    fi
    printf '%s' "$v"
}

if [[ "$ENFORCE_EFFORT" == "true" && -n "$TIERS_CSV" ]]; then
    EFFORTS_OK=()
    EFFORT_UNCONSTRAINED=""
    IFS=',' read -r -a ETIER_ARR <<< "$TIERS_CSV"
    for tier in ${ETIER_ARR[@]+"${ETIER_ARR[@]}"} "standard"; do
        [[ -z "$tier" ]] && continue
        E=$(effort_for_tier "$tier")
        # Unknown tier -> contributes nothing (fail-open per member).
        [[ -z "$E" ]] && continue
        # Any member inheriting session effort -> no constraint at all.
        if [[ "$E" == "inherit" ]]; then
            EFFORT_UNCONSTRAINED=1
            break
        fi
        DUP=""
        for e in ${EFFORTS_OK[@]+"${EFFORTS_OK[@]}"}; do
            [[ "$e" == "$E" ]] && DUP=1
        done
        [[ -z "$DUP" ]] && EFFORTS_OK+=("$E")
    done

    if [[ -n "$EFFORT_UNCONSTRAINED" ]]; then
        trace "$TASK_ID" "pass" "effort-inherit tiers=$TIERS_DISPLAY"
    elif [[ ${#EFFORTS_OK[@]} -eq 0 ]]; then
        trace "$TASK_ID" "pass" "effort-unknown-tier-failopen tiers=$TIERS_DISPLAY"
    else
        EFFORT_MATCH=""
        for e in "${EFFORTS_OK[@]}"; do
            [[ -n "$AGENT_EFFORT" && "$AGENT_EFFORT" == "$e" ]] && EFFORT_MATCH=1
        done
        if [[ -z "$EFFORT_MATCH" ]]; then
            trace "$TASK_ID" "block" "effort-mismatch tiers=$TIERS_DISPLAY required=${EFFORTS_OK[*]} got=${AGENT_EFFORT:-none}"
            {
                echo "AGENT DISPATCH DOES NOT MATCH TASK THINKING EFFORT"
                echo
                echo "Task #$TASK_ID ('$SUBJECT') is the most recent of the in_progress"
                echo "tasks (tiers in progress: $TIERS_DISPLAY). The active routing file"
                echo "($ROUTING_LABEL) sets \"enforceEffort\": true, and those tiers require"
                echo "thinking effort: ${EFFORTS_OK[*]}"
                if [[ -z "$AGENT_EFFORT" ]]; then
                    echo "Your Agent call pins no effort at all."
                else
                    echo "Your Agent call resolves to effort '$AGENT_EFFORT'."
                fi
                echo
                echo "The Agent tool has no effort parameter, so effort comes from the"
                echo "agent definition named by subagent_type. Dispatch through an"
                echo "effort-pinned agent type whose frontmatter pins the required"
                echo "effort. Enabling enforcement via /onboard writes effort-low,"
                echo "effort-medium and effort-high into .claude/agents/ for exactly"
                echo "this; they pin no model, so keep passing the model parameter"
                echo "as usual. Any agent definition of your own works too - it just"
                echo "needs an 'effort:' key in its frontmatter."
                echo
                echo "Options:"
                echo "  1. Re-issue with subagent_type set to an effort-pinned type"
                echo "     matching one of: ${EFFORTS_OK[*]}"
                echo "  2. If this dispatch genuinely serves no in_progress task, or a"
                echo "     tier is wrong, update that task's metadata via TaskUpdate"
                echo "     transparently, then retry."
                echo "  3. Escalate via AskUserQuestion if the effort map itself is wrong."
                echo
                echo "Capability and effort are independent dials: when a task outgrows"
                echo "its tier, escalate the TIER, never the effort."
                echo
                echo "Tier rules: docs/model-routing-flow.md"
                echo "(Disable effort enforcement: remove \"enforceEffort\" from"
                echo "$ROUTING_LABEL. Runtime disable: SUPERPOWERS_ROUTING_GUARD=0.)"
            } >&2
            exit 2
        fi
        trace "$TASK_ID" "pass" "effort-match tiers=$TIERS_DISPLAY effort=$AGENT_EFFORT"
    fi
fi

# Custom agent type exempt from the MODEL check - it passed its own model
# param (own cost profile), or its definition pins no resolvable model. This
# used to exit immediately at the top of the hook; it now lands here so the
# effort check above still runs for these dispatches.
if [[ -n "$MODEL_EXEMPT" ]]; then
    echo "$ALLOW"; exit 0
fi

# Any in_progress task with a concrete model pin → defer entirely:
# pre-agent-task-dispatch-validate owns pin enforcement, and double-blocking
# the same dispatch from two gates would deadlock.
if [[ "$HAS_PIN" == "true" ]]; then
    trace "$TASK_ID" "pass" "pin-owned-by-dispatch-validate"
    echo "$ALLOW"; exit 0
fi

trace "$TASK_ID" "parsed" "tiers=$TIERS_DISPLAY"

# Build the allowed model set: the UNION of every in_progress task's resolved
# tier (bounded parallel dispatch means a dispatch may serve any of them),
# PLUS the reviewer tier ("standard") because spec & code-quality reviewers
# run at standard while their task is in_progress.
ALLOWED=()
IFS=',' read -r -a TIER_ARR <<< "$TIERS_CSV"
for tier in ${TIER_ARR[@]+"${TIER_ARR[@]}"}; do
    [[ -z "$tier" ]] && continue
    R=$(echo "$ROUTING_JSON" | jq -r --arg tier "$tier" '.[$tier] // empty' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")
    # Unknown tier member → drop it (fail-open per member; typos must not brick).
    [[ -z "$R" ]] && continue
    # Any member resolving to "inherit" → no constraint at all.
    if [[ "$R" == "inherit" ]]; then
        trace "$TASK_ID" "pass" "tier-inherit tiers=$TIERS_DISPLAY"
        echo "$ALLOW"; exit 0
    fi
    DUP=""
    for m in ${ALLOWED[@]+"${ALLOWED[@]}"}; do
        [[ "$m" == "$R" ]] && DUP=1
    done
    [[ -z "$DUP" ]] && ALLOWED+=("$R")
done

# Every tier was unknown to the routing file → fail-open.
if [[ ${#ALLOWED[@]} -eq 0 ]]; then
    trace "$TASK_ID" "pass" "unknown-tier-failopen tiers=$TIERS_DISPLAY"
    echo "$ALLOW"; exit 0
fi

STANDARD_RESOLVED=$(echo "$ROUTING_JSON" | jq -r '.standard // empty' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")

# "standard" → "inherit" makes the reviewer member a wildcard: allow any.
if [[ "$STANDARD_RESOLVED" == "inherit" ]]; then
    trace "$TASK_ID" "pass" "standard-inherit-wildcard tiers=$TIERS_DISPLAY"
    echo "$ALLOW"; exit 0
fi

if [[ -n "$STANDARD_RESOLVED" ]]; then
    DUP=""
    for m in "${ALLOWED[@]}"; do
        [[ "$m" == "$STANDARD_RESOLVED" ]] && DUP=1
    done
    [[ -z "$DUP" ]] && ALLOWED+=("$STANDARD_RESOLVED")
fi

GOT_DISPLAY="${AGENT_MODEL:-(none)}"
if [[ -n "$AGENT_MODEL" ]]; then
    for m in "${ALLOWED[@]}"; do
        if [[ "$AGENT_MODEL" == "$m" ]]; then
            trace "$TASK_ID" "pass" "tier-match tiers=$TIERS_DISPLAY model=$AGENT_MODEL"
            echo "$ALLOW"; exit 0
        fi
    done
fi

trace "$TASK_ID" "block" "tier-mismatch tiers=$TIERS_DISPLAY allowed=${ALLOWED[*]} got=$AGENT_MODEL"

STANDARD_DISPLAY="${STANDARD_RESOLVED:-(tier 'standard' not mapped in routing file)}"
PRIMARY_RESOLVED="${ALLOWED[0]}"

{
    echo "AGENT DISPATCH DOES NOT MATCH TASK MODEL TIER"
    echo
    echo "Task #$TASK_ID ('$SUBJECT') is the most recent of the in_progress"
    echo "tasks (tiers in progress: $TIERS_DISPLAY). The active routing file"
    echo "($ROUTING_LABEL) resolves those to model '$PRIMARY_RESOLVED'"
    echo "(full allowed set: ${ALLOWED[*]}). Your Agent call passed model='$GOT_DISPLAY'."
    echo
    echo "Allowed per $ROUTING_LABEL:"
    echo "  - implementer / fix dispatches → the model of the task they serve (allowed set above)"
    echo "  - spec & code-quality reviewers → model: $STANDARD_DISPLAY"
    echo "  - final whole-plan reviewer (runs after all tasks complete) → no in_progress task, this gate won't fire"
    echo
    echo "Options:"
    echo "  1. Re-issue the Agent call with the model matching the task this"
    echo "     dispatch serves — one of: ${ALLOWED[*]} (the plan tiered these"
    echo "     tasks for cost reasons)."
    echo "  2. If this dispatch is genuinely not work for any in_progress task"
    echo "     (unrelated helper call), or a tier is wrong, update that task's"
    echo "     metadata via TaskUpdate transparently, then retry."
    echo "  3. Escalate to the user via AskUserQuestion if you believe the routing"
    echo "     mapping itself is wrong."
    echo
    echo "Tier rules: docs/model-routing-flow.md"
    echo "(Runtime disable: SUPERPOWERS_ROUTING_GUARD=0. Trace log: $TRACE_LOG)"
} >&2

exit 2
