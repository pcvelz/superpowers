#!/usr/bin/env bash
# SessionStart hook for superpowers plugin

set -euo pipefail

# Determine plugin root directory.
# Splits $0 on its last / or \ (run-hook.cmd's cmd half passes a Windows
# path), with no separator meaning the current directory. This avoids
# dirname because a SessionStart:startup hook can run with a broken/empty
# PATH (anthropics/claude-code#43127) before any PATH-repairing sibling hook
# in the same startup batch takes effect.
#
# No command substitution or pipe runs in this script: each one forks, and a
# fork costs tens of milliseconds under Git Bash on Windows. The paths stay
# relative to the current directory, which is all the file read below needs.
case "$0" in
  */*|*\\*) SCRIPT_DIR="${0%[/\\]*}" ;;
  *) SCRIPT_DIR="." ;;
esac
PLUGIN_ROOT="${SCRIPT_DIR}/.."

# Model routing opt-in notice — when the project carries the routing file, or
# a user-level default exists at ~/.claude/superpowers/ (project file wins).
# Knowledge is injected here so agents never depend on voluntarily reading docs.
# The file is project-controlled (hostile) content: strip ALL control bytes
# (not just \n\r\t) or an embedded \x01/\x0b/\x0c would invalidate the JSON
# this hook emits and kill the whole bootstrap injection. LC_ALL=C keeps tr
# byte-wise so invalid UTF-8 cannot make BSD tr abort mid-stream, and
# iconv -c drops any invalid UTF-8 bytes that would equally break the JSON.
# Git for Windows ships no iconv: piping through a missing binary made the
# whole substitution fall back to '{}' and swallow the mapping, so the iconv
# pass is applied only when iconv exists (tr already stripped control bytes).
sanitize_json_file() {
    if ! command -v tr >/dev/null 2>&1; then
        # Broken PATH (#2310): strip control bytes in pure bash instead of
        # invoking a missing tr. No LC_ALL=C here: switching locale with an
        # empty PATH segfaults Homebrew bash 5.3 (about 1 run in 15).
        local content
        content=$(< "$1") || { echo '{}'; return 0; }
        printf '%s' "${content//[[:cntrl:]]/}"
    elif command -v iconv >/dev/null 2>&1; then
        LC_ALL=C tr -d '[:cntrl:]' < "$1" 2>/dev/null | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || echo '{}'
    else
        LC_ALL=C tr -d '[:cntrl:]' < "$1" 2>/dev/null || echo '{}'
    fi
}
# Regex capture group 1 of the last [[ =~ ]] match, into rx_group. bash keeps
# captures in BASH_REMATCH (0-indexed); zsh keeps them in $match (1-indexed)
# and leaves BASH_REMATCH unset, which set -u turns into a fatal error
# (#2503: run-hook.cmd falls back to zsh when bash is missing). Every capture
# goes through here so no call site depends on the shell.
regex_group1() {
    if [ -n "${ZSH_VERSION-}" ]; then
        rx_group="${match[1]-}"
    else
        rx_group="${BASH_REMATCH[1]-}"
    fi
}
routing_message=""
routing_file="${PWD}/docs/superpowers/model-routing.json"
routing_label="docs/superpowers/model-routing.json"
if [ ! -f "$routing_file" ]; then
    # User-level default: applies to every project without a project file.
    routing_file="${HOME}/.claude/superpowers/model-routing.json"
    routing_label="~/.claude/superpowers/model-routing.json"
fi
if [ -f "$routing_file" ]; then
    routing_mapping=$(sanitize_json_file "$routing_file")
    routing_message="\n\n<model-routing-active>This project routes plan-execution subagents to cheaper models. Mapping (${routing_label}): ${routing_mapping}. Plan-time: every plan task's json:metadata fence MUST carry \"modelTier\" — \"mechanical\" (1-2 files, complete spec with code in the steps, no design judgment; most tasks in a well-specified plan), \"standard\" (multi-file integration, pattern matching, debugging), or \"frontier\" (design/architecture judgment). Tie-break: spec completeness wins. Dispatch-time: pass the Agent model parameter resolved from the in-progress task's tier via the mapping (\"inherit\" = omit the parameter); spec and code-quality reviewers use the \"standard\" tier's model; the final whole-plan reviewer (after all tasks complete) stays at session level — omit the model parameter. A task metadata \"model\" pin overrides its tier. Plugin gates enforce both sides (kill switch: SUPERPOWERS_ROUTING_GUARD=0). Full rationale: docs/model-routing-flow.md in the plugin repo.</model-routing-active>"
    # Per-tier thinking-effort map. IMPLICIT BY DEFAULT: whenever routing is
    # active the notice carries the recommended map even if the file never
    # mentions effort — the orchestrating model picks effort autonomously at
    # dispatch time; the file key is an override, not an enabler (same
    # pattern sonnetEffort followed). Sanitize collapsed the file to one
    # line, so a bracket-bounded bash regex match is safe. Pure bash (no sed):
    # PATH-independent like the rest of the hook. Matches the FIRST occurrence
    # of the key; keys are unique in valid config.
    effort_map=""
    effort_re='"effort"[[:space:]]*:[[:space:]]*\{([^}]*)\}'
    if [[ $routing_mapping =~ $effort_re ]]; then
        regex_group1
        effort_map="{${rx_group}}"
    fi
    if [ -n "$effort_map" ]; then
        effort_label="${routing_label}, user-set"
    else
        effort_map='{"mechanical":"low","standard":"medium","frontier":"inherit"}'
        effort_label="implicit default; add an \"effort\" key to ${routing_label} to override"
    fi
    # Enforcement is opt-in: "enforceEffort": true turns the dispatch gate's
    # effort check on. Absent/false keeps the historical advisory wording, so
    # existing installs read exactly what they read before.
    # Capture the bare token with a bash regex and compare in the shell.
    enforce_effort=""
    enforce_re='"enforceEffort"[[:space:]]*:[[:space:]]*([a-z]*)'
    if [[ $routing_mapping =~ $enforce_re ]]; then
        regex_group1
        enforce_effort="$rx_group"
    fi
    if [ "$enforce_effort" = "true" ]; then
        effort_enforcement="ENFORCED: the dispatch gate resolves the effort your subagent_type pins (agent-definition frontmatter \`effort:\`) and blocks a dispatch that does not match the tier's effort. The Agent tool has no effort parameter, so route through an effort-pinned agent type — /onboard writes \`effort-low\`, \`effort-medium\` and \`effort-high\` into .claude/agents/ when enforcement is enabled, and they pin no model, so keep passing the model parameter as usual. Any agent definition carrying an \`effort:\` key works. Note that with enforcement on, such definitions also have their model parameter checked against the tier — an exemption they keep while enforcement is off."
    else
        effort_enforcement="Advisory only; no gate enforces effort unless the routing file sets \"enforceEffort\": true."
    fi
    routing_message="${routing_message} <effort-routing-active>Per-tier thinking effort for routed dispatches. Effort map (${effort_label}): ${effort_map} (\"inherit\" = session effort). Apply it wherever effort is controllable: Workflow agent() calls take a per-dispatch effort option; custom agent definitions can pin effort in frontmatter; the plain Agent tool has no effort parameter, so prefer effort-pinned agent types for routed-down dispatches. Capability and thinking effort are independent dials — raising effort on a routed-down model does not recover capability, so when a task outgrows its tier at the mapped effort, escalate the TIER (model), never the effort. In particular: Sonnet above medium costs Opus-class money for lower fidelity. ${effort_enforcement}</effort-routing-active>"
    # Back-compat: honor an explicit sonnetEffort key from earlier onboardings
    # as a Sonnet-specific override on top of the map.
    sonnet_effort=""
    sonnet_re='"sonnetEffort"[[:space:]]*:[[:space:]]*"([^"]*)"'
    if [[ $routing_mapping =~ $sonnet_re ]]; then
        regex_group1
        sonnet_effort="$rx_group"
    fi
    if [ -n "$sonnet_effort" ]; then
        routing_message="${routing_message%</effort-routing-active>} User-set \"sonnetEffort\": \"${sonnet_effort}\" overrides the map for any dispatch resolving to model \"sonnet\".</effort-routing-active>"
    fi
fi

# Commit-strategy opt-in notice — when the project carries the workflow file,
# or a user-level default exists at ~/.claude/superpowers/ (project file wins
# entirely, no merging — same lookup pattern as model-routing.json).
# The file is project-controlled (hostile) content: sanitize with the same
# LC_ALL=C tr -d '[:cntrl:]' + iconv -c pass as the routing file BEFORE
# parsing. Stripping control bytes also collapses the file to one line, which
# makes the single-line regex extraction immune to multi-line JSON formatting.
# The extracted value is only compared, never embedded in the notice.
# Absent file, absent key, or any value other than "at-end" → no notice,
# byte-identical default behavior (per-task commits). Fail-open throughout.
workflow_message=""
workflow_file="${PWD}/docs/superpowers/workflow.json"
workflow_label="docs/superpowers/workflow.json"
if [ ! -f "$workflow_file" ]; then
    # User-level default: applies to every project without a project file.
    workflow_file="${HOME}/.claude/superpowers/workflow.json"
    workflow_label="~/.claude/superpowers/workflow.json"
fi
if [ -f "$workflow_file" ]; then
    workflow_config=$(sanitize_json_file "$workflow_file")
    commit_strategy=""
    commit_re='"commitStrategy"[[:space:]]*:[[:space:]]*"([^"]*)"'
    if [[ $workflow_config =~ $commit_re ]]; then
        regex_group1
        commit_strategy="$rx_group"
    fi
    if [ "$commit_strategy" = "at-end" ]; then
        workflow_message="\n\n<workflow-config-active>This project sets \"commitStrategy\": \"at-end\" (${workflow_label}): one commit per plan, not per task. Plan-time: OMIT the per-task Commit step from every task's Steps; instead add ONE final task — 'Commit the full implementation' — at the end of the plan, blockedBy ALL implementation tasks, whose steps stage and commit the entire change set as a single commit. Dispatch-time: tell implementer subagents NOT to commit (replace the 'Commit your work' instruction with: do not commit; leave all changes in the working tree — the coordinator's final task makes the single commit). Reviewers review the uncommitted working-tree diff instead of per-task commit SHAs. Ledger completion lines cite the working tree instead of a commit range: 'Task <N>: complete (working tree, at-end strategy, review clean)' — never invent placeholder hashes. A TaskCreate gate enforces the plan-time side; dispatch-time stays advisory - comply when composing implementer prompts. Default (per-task commits) resumes when the file or key is removed. Full rationale: docs/workflow-config-flow.md in the plugin repo.</workflow-config-active>"
    fi
    # Visual-companion opt-in: "always" → offer proactively on every brainstorming
    # path. Absent key or any other value → no notice, byte-identical default
    # (just-in-time judgment call in the skill). Fail-open throughout.
    visual_companion=""
    visual_re='"visualCompanion"[[:space:]]*:[[:space:]]*"([^"]*)"'
    if [[ $workflow_config =~ $visual_re ]]; then
        regex_group1
        visual_companion="$rx_group"
    fi
    if [ "$visual_companion" = "always" ]; then
        workflow_message="${workflow_message}\n\n<visual-companion-active>This project sets \"visualCompanion\": \"always\" (${workflow_label}): during brainstorming, on EVERY path (spike, bounded, architectural), offer the visual companion the moment the design involves a screen, a layout, a diagram, or a side-by-side comparison. Tripwire: if you are about to draw ANY ASCII mockup, layout sketch, or option comparison, STOP — the offer comes FIRST, as its own message, before the first ASCII character. Drawing ASCII layouts without having offered is the exact failure this setting exists to prevent. The offer itself follows the brainstorming skill unchanged: the user decides, a decline means text-only (ASCII is then fine) for the rest of the session. Default (just-in-time judgment call, architectural path only) resumes when the file or key is removed.</visual-companion-active>"
    fi
fi

# Read using-superpowers content with the read builtin (no cat, for the same
# PATH-independence reason, and no $(< file) subshell). read returns 1 at end
# of file, hence || true; the loop drops trailing newlines as $(< file) did.
skill_md="${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md"
using_superpowers_content="Error reading using-superpowers skill"
if [ -r "$skill_md" ]; then
  IFS= read -r -d '' using_superpowers_content < "$skill_md" || true
  while [[ $using_superpowers_content == *$'\n' ]]; do
    using_superpowers_content="${using_superpowers_content%$'\n'}"
  done
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces. The result
# goes to a variable instead of stdout, so no $(...) subshell is needed.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    using_superpowers_escaped="$s"
}

escape_for_json "$routing_message"
routing_escaped="$using_superpowers_escaped"
escape_for_json "$workflow_message"
workflow_escaped="$using_superpowers_escaped"
escape_for_json "$using_superpowers_content"
session_context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Below is the full content of your 'superpowers-extended-cc:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}\n\n${routing_escaped}${workflow_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# SDK-standard clients expect additionalContext (top-level).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
#
# emit_json absorbs EPIPE without a pipe through `cat`. On Windows + Git
# Bash, the harness can close the hook's stdout before printf finishes, and
# Git Bash's printf reports that EPIPE as "printf: write error: Permission
# denied", which `set -euo pipefail` would let escape as a startup diagnostic
# every session (#1612). SIGPIPE is ignored so other platforms see the same
# EPIPE error instead of a signal; the error message is dropped and the
# status ignored. No external command is involved, so a broken PATH (#2310)
# changes nothing.
emit_json() {
  trap '' PIPE
  # shellcheck disable=SC2059 # every caller passes a literal format string
  printf "$@" 2>/dev/null || true
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  emit_json '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Unknown / SDK-standard platform (top-level additionalContext format); the SDK client env flag COPILOT_CLI=1 also lands here
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
